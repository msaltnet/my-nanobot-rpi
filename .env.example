OPENAI_API_KEY=sk-your-key-here
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_USER_ID=your-telegram-user-id
# 선택: 뉴스 검색 보강 provider
TAVILY_API_KEY=tvly-your-key-here
BRAVE_API_KEY=BSA-your-key-here

# 선택: 배포·검증 대상 기록 (운영자/Agent가 비공개로 읽는 메타데이터)
# 앱이나 deploy/setup-rpi.sh가 아래 항목으로 자동 접속·배포하지 않습니다.
# 실제 값은 .env에만 기록합니다. 대상 지정은 배포 승인을 대신하지 않습니다.
# rpi 또는 oci
DEPLOY_PLATFORM=
# 운영자가 선택한 SSH config 별칭 또는 접속 대상 (비밀번호/토큰을 넣지 않음)
DEPLOY_SSH_TARGET=
# 대상 Linux 호스트의 checkout 절대 경로
DEPLOY_REPO_DIR=
# 대상 서비스 실행 사용자
DEPLOY_RUN_USER=
# 대상 호스트의 비공개 백업 루트 절대 경로 (checkout/workspace 밖)
DEPLOY_BACKUP_DIR=
